# SPDX-License-Identifier: GPL-2.0-or-later
# Ducky One 3 SF RGB with the SF-RGB firmware: let the logged-in user open the lighting
# interface (raw HID, USB interface 1) without sudo. The keyboard interfaces themselves stay
# root-only, so no user process can read keystrokes through them.
#   sudo cp 70-duckylight.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
# The 70- prefix matters: uaccess tags must be applied before 73-seat-late.rules.
KERNEL=="hidraw*", DEVPATH=="*:1.1/0003:3233:5311.*", MODE="0660", TAG+="uaccess"
